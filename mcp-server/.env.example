# bkc-mcp-server — local only, never deployed.
#
# ⚠️ SUPABASE_SERVICE_ROLE_KEY_* bypasses Row Level Security entirely. Unlike
# client/.env.local (anon keys, safe to expose to a browser), the values below
# are real secrets. Never commit this file as `.env`, never paste it anywhere
# public, never use it in `client/`.
#
# Copy this file to `.env` (gitignored) and fill in both projects' service_role
# keys (Supabase dashboard → Project Settings → API → service_role). Find the
# URLs/anon keys' counterparts already in client/.env.local for reference.

SUPABASE_URL_TEST=
SUPABASE_SERVICE_ROLE_KEY_TEST=

SUPABASE_URL_PROD=
SUPABASE_SERVICE_ROLE_KEY_PROD=

# Which pair to use. Defaults to "test" even if this line is missing — a
# wrong guess with a service_role key should fail safe, not land on real data.
# Flip to "prod" only once you've exercised every tool against TEST.
SUPABASE_TARGET=test
